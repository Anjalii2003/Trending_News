# ── Secrets ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
delivery/.env

# ── Environments / dependencies ─────────────────────────────────────────
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# ── Corpus-derived data (never commit — contains scraped post content) ──
# Everything under data/ is generated by the pipeline from the production
# corpus, except the small hand-authored config inputs whitelisted below.
data/*
!data/taxonomy.json
!data/taxonomy_cameo.json
!data/thresholds_cameo.json
!data/gazetteer.json
!data/publisher_registry.csv   # reviewable config: domains + countries only, no article content
# data/calibration_cameo.csv holds raw post text — kept local on purpose.

*.duckdb
*.duckdb.wal
*.duckdb.bak*
*.parquet
*.npy

# Dashboard snapshot (rebuilt by UI/build_dashboard.py)
UI/data/

# ── Generated reports that embed corpus content ─────────────────────────
reports/EDA_Report.html
reports/figures/
reports/*.json
reports/*.csv
reports/*.log
reports/*.log.*
reports/news/      # pilot samples contain headlines

# ── Logs / runtime state ─────────────────────────────────────────────────
logs/
*.log
nohup.out

# ── Raw chat exports (contain connection details) ───────────────────────
collaboration/00_CLAUDE_CHAT_EXPORT.md
grokplans/ClaudeChat.md

# ── Editor / OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
*.swp

# ── News Engine deployment secrets (generated by deploy/bootstrap_pg.py) ──
deploy/*.env
!deploy/*.env.example
